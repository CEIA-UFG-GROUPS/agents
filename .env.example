# Copy this file to .env and fill in your values. Never commit the real .env.
#
#   cp .env.example .env
#
# Airport/location resolution uses Gemini only when LLM_ENABLED=true; otherwise
# the offline demo provider is used and no API key is required.

LLM_ENABLED=false
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_ADVANCED_MODEL=gemini-3.1-pro-preview
